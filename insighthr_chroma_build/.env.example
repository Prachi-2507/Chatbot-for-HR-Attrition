# Google AI Studio / Gemini API key
# Get one from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=yoyr API Key
# Gemini model used for routing, SQL generation, RAG answers, and synthesis
GEMINI_MODEL=gemini-3.6-flash

# Gemini embedding model used by ChromaDB
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional overrides. Defaults point to the bundled files.
# HR_CSV_PATH=../data/hr_attrition.csv
# SQLITE_DB_PATH=../data/hr_attrition.db
# CHROMA_DIR=../chroma_db
